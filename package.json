{
  "name": "argus-planspiel",
  "private": true,
  "version": "0.5.0",
  "description": "Planspiel ARGUS – Auswirkungen von KI auf die Entscheidungsfindung (fiktiv)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --mode offline && node tools/nach_build.mjs",
    "build:online": "vite build",
    "build:offline": "vite build --mode offline",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pruefe-daten": "vite-node tools/pruefe_daten.ts",
    "assets": "python3 tools/assets/gen_assets.py --cache .assets-cache.pkl"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "targaryen": "^3.1.0",
    "typescript": "~5.9",
    "vite": "^8.3.4",
    "vite-node": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "preact": "^11.0.1"
  }
}
