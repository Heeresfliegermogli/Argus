{
  "rules": {
    ".read": false,
    ".write": false,
    "argus": {
      "v1": {
        "sitzungen": {
          "$s": {
            ".read": "$s.matches(/^[a-z0-9-]{3,32}$/)",
            "info": {
              ".write": "$s.matches(/^[a-z0-9-]{3,32}$/) && !data.exists()",
              ".validate": "newData.hasChildren(['code', 'szenario', 'version', 'titel', 'erstellt', 'von'])",
              "code": {
                ".validate": "newData.isString() && newData.val().toLowerCase() === $s"
              },
              "szenario": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "version": {
                ".validate": "newData.isString() && newData.val().length <= 20"
              },
              "titel": {
                ".validate": "newData.isString() && newData.val().length <= 120"
              },
              "erstellt": {
                ".validate": "newData.isNumber() && newData.val() <= now + 600000"
              },
              "von": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "$weiteres": {
                ".validate": false
              }
            },
            "host": {
              ".write": "$s.matches(/^[a-z0-9-]{3,32}$/)",
              ".validate": "newData.hasChildren(['id', 'name', 'puls'])",
              "id": {
                ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{6}$/)"
              },
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "puls": {
                ".validate": "newData.isNumber() && newData.val() <= now + 600000"
              },
              "$weiteres": {
                ".validate": false
              }
            },
            "anwesenheit": {
              "$client": {
                ".write": "$s.matches(/^[a-z0-9-]{3,32}$/) && $client.matches(/^[a-z0-9]{6}$/)",
                ".validate": "newData.hasChildren(['client', 'art', 'name', 'puls'])",
                "client": {
                  ".validate": "newData.val() === $client"
                },
                "art": {
                  ".validate": "newData.isString() && newData.val().matches(/^(tt|sl|plenum)$/)"
                },
                "name": {
                  ".validate": "newData.isString() && newData.val().length <= 40"
                },
                "puls": {
                  ".validate": "newData.isNumber() && newData.val() <= now + 600000"
                },
                "version": {
                  ".validate": "newData.isString() && newData.val().length <= 20"
                },
                "team": {
                  ".validate": "newData.isString() && newData.val().matches(/^t[a-z0-9]{4,8}$/)"
                },
                "$weiteres": {
                  ".validate": false
                }
              }
            },
            "teams": {
              "$team": {
                ".write": "$s.matches(/^[a-z0-9-]{3,32}$/) && $team.matches(/^t[a-z0-9]{4,8}$/)",
                ".validate": "newData.hasChildren(['name', 'farbe', 'erstellt'])",
                "name": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
                },
                "farbe": {
                  ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-f]{6}$/)"
                },
                "erstellt": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 600000"
                },
                "lauf": {
                  ".validate": "newData.isString() && newData.val().matches(/^[0-9]{8}-[0-9]{4}-[a-z0-9]{4}$/)"
                },
                "spieler": {
                  "$client": {
                    ".validate": "$client.matches(/^[a-z0-9]{6}$/) && newData.hasChildren(['name', 'rollen'])",
                    "name": {
                      ".validate": "newData.isString() && newData.val().length <= 40"
                    },
                    "rollen": {
                      ".validate": "newData.isString() && newData.val().matches(/^(g1|g2|g3)(,(g1|g2|g3)){0,2}$/)"
                    },
                    "seit": {
                      ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 600000"
                    },
                    "$weiteres": {
                      ".validate": false
                    }
                  }
                },
                "$weiteres": {
                  ".validate": false
                }
              }
            },
            "laeufe": {
              "$team": {
                ".validate": "$team.matches(/^t[a-z0-9]{4,8}$/)",
                "$lauf": {
                  ".validate": "$lauf.matches(/^[0-9]{8}-[0-9]{4}-[a-z0-9]{4}$/)",
                  "protokoll": {
                    "$e": {
                      ".write": "$s.matches(/^[a-z0-9-]{3,32}$/) && !data.exists()",
                      ".validate": "$e.matches(/^e[0-9]{6}$/) && newData.hasChildren(['seq', 'typ', 'ts', 't_s', 'von', 'daten'])",
                      "seq": {
                        ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999999"
                      },
                      "typ": {
                        ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{2,24}$/)"
                      },
                      "ts": {
                        ".validate": "newData.isNumber() && newData.val() > now - 86400000 && newData.val() < now + 600000"
                      },
                      "t_s": {
                        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                      },
                      "aktion": {
                        ".validate": "newData.isString() && newData.val().length <= 40"
                      },
                      "ts_aktion": {
                        ".validate": "newData.isNumber()"
                      },
                      "von": {
                        ".validate": "newData.hasChild('rolle')",
                        "rolle": {
                          ".validate": "newData.isString() && newData.val().matches(/^(g1|g2|g3|sl|plenum|system)$/)"
                        },
                        "client": {
                          ".validate": "newData.isString() && newData.val().length <= 12"
                        },
                        "name": {
                          ".validate": "newData.isString() && newData.val().length <= 40"
                        },
                        "$weiteres": {
                          ".validate": false
                        }
                      },
                      "daten": {
                        ".validate": "newData.hasChildren()",
                        "$feld": {
                          ".validate": "$feld.matches(/^[a-z_]{1,24}$/) && (newData.isBoolean() || newData.isNumber() || (newData.isString() && newData.val().length <= 600) || newData.hasChildren())",
                          "$i": {
                            ".validate": "newData.isBoolean() || newData.isNumber() || (newData.isString() && newData.val().length <= 300) || newData.hasChildren()",
                            "$k": {
                              ".validate": "newData.isBoolean() || newData.isNumber() || (newData.isString() && newData.val().length <= 100)"
                            }
                          }
                        }
                      },
                      "$weiteres": {
                        ".validate": false
                      }
                    }
                  },
                  "aktionen": {
                    "$a": {
                      ".write": "$s.matches(/^[a-z0-9-]{3,32}$/) && !data.exists()",
                      ".validate": "$a.matches(/^[-A-Za-z0-9_]{10,40}$/) && newData.hasChildren(['id', 'typ', 'von', 'ts', 'daten'])",
                      "id": {
                        ".validate": "newData.val() === $a"
                      },
                      "typ": {
                        ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{2,24}$/)"
                      },
                      "ts": {
                        ".validate": "newData.isNumber() && newData.val() >= 0"
                      },
                      "von": {
                        ".validate": "newData.hasChildren(['rolle', 'client'])",
                        "rolle": {
                          ".validate": "newData.isString() && newData.val().matches(/^(g1|g2|g3|sl|plenum)$/)"
                        },
                        "client": {
                          ".validate": "newData.isString() && newData.val().length <= 12"
                        },
                        "name": {
                          ".validate": "newData.isString() && newData.val().length <= 40"
                        },
                        "$weiteres": {
                          ".validate": false
                        }
                      },
                      "daten": {
                        ".validate": "newData.hasChildren()",
                        "$feld": {
                          ".validate": "$feld.matches(/^[a-z_]{1,24}$/) && (newData.isBoolean() || newData.isNumber() || (newData.isString() && newData.val().length <= 600) || newData.hasChildren())",
                          "$i": {
                            ".validate": "newData.isBoolean() || newData.isNumber() || (newData.isString() && newData.val().length <= 300)"
                          }
                        }
                      },
                      "$weiteres": {
                        ".validate": false
                      }
                    }
                  },
                  "$weiteres": {
                    ".validate": false
                  }
                }
              }
            },
            "$weiteres": {
              ".validate": false
            }
          }
        }
      }
    },
    "rooms": {
      "$raum": {
        ".read": "$raum.matches(/^[A-Za-z0-9_%-]{1,40}$/)",
        "peers": {
          "$id": {
            ".write": "$id.matches(/^[a-z0-9]{1,12}$/)",
            ".validate": "newData.hasChildren(['name', 't'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "modus": {
              ".validate": "newData.isString() && newData.val().length <= 10"
            },
            "ua": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "$weiteres": {
              ".validate": false
            }
          }
        },
        "pings": {
          "$von": {
            ".write": "$von.matches(/^[a-z0-9]{1,12}$/)",
            "$k": {
              ".validate": "$k.matches(/^[a-z0-9_]{1,20}$/) && newData.hasChildren(['t'])",
              "t": {
                ".validate": "newData.isNumber()"
              },
              "$weiteres": {
                ".validate": false
              }
            }
          }
        },
        "pongs": {
          "$von": {
            ".write": "$von.matches(/^[a-z0-9]{1,12}$/)",
            "$k": {
              ".validate": "$k.matches(/^[a-z0-9_]{1,40}$/) && newData.hasChildren(['by'])",
              "by": {
                ".validate": "newData.isString() && newData.val().length <= 12"
              },
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 60"
              },
              "modus": {
                ".validate": "newData.isString() && newData.val().length <= 10"
              },
              "$weiteres": {
                ".validate": false
              }
            }
          }
        },
        "markers": {
          "$id": {
            ".write": "$id.matches(/^[a-z0-9]{1,12}$/)",
            ".validate": "newData.hasChildren(['x', 'y'])",
            "x": {
              ".validate": "newData.isNumber()"
            },
            "y": {
              ".validate": "newData.isNumber()"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "$weiteres": {
              ".validate": false
            }
          }
        },
        "$weiteres": {
          ".validate": false
        }
      }
    }
  }
}
